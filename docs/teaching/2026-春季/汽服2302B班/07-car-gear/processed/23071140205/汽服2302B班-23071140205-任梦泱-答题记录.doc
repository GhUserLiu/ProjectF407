    <w:body>
        <wx:sect>
            <w:p
                    wsp:rsidR="00000000" wsp:rsidRDefault="001E71E7">
                <w:pPr>
                    <w:jc w:val="center"/>
                    <w:rPr>
                        <w:rFonts
                                w:ascii="宋体" w:h-ansi="宋体"/>
                        <wx:font wx:val="宋体"/>
                    </w:rPr>
                </w:pPr>
                <w:r>
                    <w:rPr>
                        <w:rFonts
                                w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/>
                        <wx:font wx:val="宋体"/>
                        <w:sz
                                w:val="44"/>
                        <w:sz-cs w:val="44"/>
                    </w:rPr>
                    <w:t>​实验报告（第七次实验 汽车档位模拟器设计）</w:t>
                </w:r>
                <w:r>
                    <w:rPr>
                        <w:rFonts
                                w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/>
                        <wx:font wx:val="宋体"/>
                        <w:sz
                                w:val="44"/>
                        <w:sz-cs w:val="44"/>
                    </w:rPr>
                    <w:t></w:t>
                </w:r>
                <w:r>
                    <w:t></w:t>
                </w:r>
            </w:p>
            <w:p
                    wsp:rsidR="00000000" wsp:rsidRDefault="001E71E7">
                <w:pPr>
                    <w:jc w:val="center"/>
                    <w:rPr>
                        <w:rFonts
                                w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/>
                        <wx:font wx:val="宋体"/>
                    </w:rPr>
                </w:pPr>
                <w:r>
                    <w:rPr>
                        <w:rFonts
                                w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/>
                        <wx:font wx:val="宋体"/>
                    </w:rPr>
                    <w:t></w:t>
                </w:r>
            </w:p>
            <w:p
                    wsp:rsidR="00000000" wsp:rsidRDefault="001E71E7">
                <w:pPr>
                    <w:rPr>
                        <w:rFonts
                                w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/>
                        <wx:font wx:val="宋体"/>
                        <w:color
                                w:val="FF0000"/>
                        <w:sz w:val="44"/>
                        <w:sz-cs w:val="44"/>
                    </w:rPr>
                </w:pPr>
                    <w:r>
                        <w:rPr>
